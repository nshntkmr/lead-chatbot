# Copy this file to .env and fill in the values.

# ---- Where Claude runs ------------------------------------------------------
# Option A: Claude API (console.anthropic.com). Set the key and leave the Foundry lines blank.
#ANTHROPIC_API_KEY=sk-ant-...

# Option B: Claude in Microsoft Foundry (Azure). Set the resource name (from the deployment's Target URI,
# https://<resource>.services.ai.azure.com/anthropic/...) and ONE of: an API key, or Entra ID.
CLAUDE_PROVIDER=foundry
ANTHROPIC_FOUNDRY_RESOURCE=my-foundry-resource
ANTHROPIC_FOUNDRY_API_KEY=
# Entra ID instead of a key: sign in with `az login` (or run under a managed identity) and set true.
# Needs: pip install azure-identity, and the "Foundry User" role on the resource.
FOUNDRY_USE_ENTRA_ID=false

# Model. On Foundry this is the DEPLOYMENT name (defaults to the model id when you deploy).
# claude-opus-5-5 for the strongest analysis; claude-sonnet-5-5 is faster and cheaper.
ANTHROPIC_MODEL=claude-opus-5-5
# Model used only to summarize very long chats (cheaper is fine). Blank = same as ANTHROPIC_MODEL.
SUMMARY_MODEL=claude-sonnet-5-5

# Name shown in the sidebar and login page
APP_NAME=ACO Data Assistant

# Columns always loaded as text (IDs with leading zeros)
TEXT_COLUMNS=TIN,NPI,CCN,ZIP

# Spend estimates = list prices × this multiplier. 1.1 for a Foundry US Data Zone deployment; <1 for a
# negotiated discount. Per-model overrides go in data\pricing.json.
PRICE_MULTIPLIER=1.0

# Long chats: older turns are summarized once the transcript passes this many (estimated) tokens.
# The working portfolio is stored separately and is never lost. Raise this only if you enable a
# long-context beta below and accept the higher per-question cost.
COMPACT_AFTER_TOKENS=120000

# How hard the model reasons before answering: low | medium | high | xhigh | max. Blank = the model's
# default (medium on Opus 5.5). "high" suits analytical questions; it is slower and costs more.
ANTHROPIC_EFFORT=
# The levels users can choose per question from the "Depth" picker in the chat box. Blank = hide the picker.
EFFORT_CHOICES=low,medium,high,xhigh

# Optional beta header(s), comma-separated. Leave blank normally. (Opus 5.5 / Sonnet 5.5 on Foundry
# already have a 1M-token context window without a beta flag.)
ANTHROPIC_BETAS=

# Set to true when served over HTTPS
COOKIE_SECURE=false
SESSION_HOURS=12

# Optional size caps on query results (JSON characters) and on per-TIN rows sent to the model.
# MAX_RESULT_CHARS_TO_CLAUDE=100000
# MAX_RESULT_CHARS_TO_UI=2000000
# MAX_TINS_TO_CLAUDE=100

# Warehouse build and query memory (see app/config.py). The build is single-threaded so memory stays within the limit.
# BUILD_THREADS=1
# BUILD_MEMORY_LIMIT=4GB
# QUERY_MEMORY_LIMIT=

# Folder holding the large CSV / Excel extracts (default: data/). The Docker image sets it to /app/source.
# SOURCE_DIR=

# Queries running at once across all chats, and the per-chat turn lock (seconds without progress before it expires).
# MAX_CONCURRENT_QUERIES=4
# TURN_LOCK_SECONDS=300
# true = also compare SHA-256 hashes of the extracts at start-up (about 10 s per GB) before reusing the warehouse.
# VERIFY_SOURCE_HASH=false

# Login lockout (counted in app.db) and the number of reverse proxies in front of the app (0 = none; Azure ingress = 1).
# LOGIN_MAX_FAILURES=8
# LOGIN_LOCKOUT_SECONDS=900
# TRUSTED_PROXY_HOPS=0
